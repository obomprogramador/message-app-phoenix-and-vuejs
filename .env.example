# ─────────────────────────────────────
# Local development (Docker Compose)
# ─────────────────────────────────────

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=message_app_dev

# Phoenix Backend
MIX_ENV=dev
PHX_HOST=localhost
SECRET_KEY_BASE=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api

# ─────────────────────────────────────
# Render (production demo)
# ─────────────────────────────────────
# These are set automatically by render.yaml blueprint.
# No need to configure manually.
#
# Backend env vars configured in render.yaml:
#   DATABASE_URL       (from Render PostgreSQL)
#   SECRET_KEY_BASE    (auto-generated)
#   MIX_ENV=prod
#   PHX_HOST=message-app-backend.onrender.com
#   PORT=4000
#
# Frontend env vars configured in render.yaml:
#   VITE_API_BASE_URL=https://message-app-backend.onrender.com/api
