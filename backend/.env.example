# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=message_app_dev

# Phoenix Backend
PHX_HOST=localhost
SECRET_KEY_BASE=$(mix phx.gen.secret)
DATABASE_URL=ecto://postgres:postgres@postgres:5432/message_app_dev

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_API=100
RATE_LIMIT_BATCH=20

# Logging
LOG_LEVEL=info

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
